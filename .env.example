VMANAGE_HOST=https://your-vmanage-host
VMANAGE_USER=admin
VMANAGE_PASS=your_password

WEBEX_TOKEN=your_webex_bot_token

# 수신자 이메일 (쉼표로 여러 명 지정 가능)
# 설정 시 개인 DM으로 전송됨
WEBEX_TO_EMAILS=user1@example.com,user2@example.com

# 이메일 미설정 시 Room으로 fallback (둘 중 하나만 설정)
# WEBEX_ROOM_ID=your_webex_room_id

# Polling interval in seconds (default: 60)
POLL_INTERVAL=60

# Comma-separated severity filter (leave empty for all)
# Options: critical,major,medium,minor,warning
SEVERITY_FILTER=critical,major
